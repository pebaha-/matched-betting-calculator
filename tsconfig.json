{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],

    "outDir": "./dist",

    "strict": true,
    "noEmitOnError": true,
    "sourceMap": true,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["script.ts"],
  "exclude": ["node_modules", "dist"]
}
